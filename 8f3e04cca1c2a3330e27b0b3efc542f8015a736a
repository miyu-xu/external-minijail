      "author": {
        "id": 1076784
      },
      "writtenOn": "2022-01-27T21:29:53Z",
      "side": 1,
      "message": "This is not about ABI, it is about changing behavior of a library (crate, whatever) without warning.",
      "parentUuid": "0b887d63_e91c88a7",
      "revId": "8f3e04cca1c2a3330e27b0b3efc542f8015a736a",
